{
  "name": "clickup-ms-planner-integration",
  "version": "1.0.0",
  "description": "Bi-directional sync between ClickUp and Microsoft Planner",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "sync": "node src/index.js sync",
    "sync:clickup-to-planner": "node src/index.js sync --direction clickup-to-planner",
    "sync:planner-to-clickup": "node src/index.js sync --direction planner-to-clickup"
  },
  "keywords": [
    "clickup",
    "microsoft-planner",
    "integration",
    "sync",
    "task-management"
  ],
  "license": "MIT",
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@azure/identity": "^4.0.0",
    "@azure/msal-node": "^2.6.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  }
}
