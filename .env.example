# ClickUp Configuration
CLICKUP_API_TOKEN=your_clickup_api_token_here
CLICKUP_TEAM_ID=your_clickup_team_id
CLICKUP_SPACE_ID=your_clickup_space_id
CLICKUP_LIST_ID=your_clickup_list_id

# Microsoft Azure AD / Entra ID Configuration
MS_CLIENT_ID=your_azure_app_client_id
MS_CLIENT_SECRET=your_azure_app_client_secret
MS_TENANT_ID=your_azure_tenant_id

# Microsoft Planner Configuration
MS_PLANNER_GROUP_ID=your_microsoft_365_group_id
MS_PLANNER_PLAN_ID=your_planner_plan_id

# Sync Configuration
SYNC_DIRECTION=bidirectional
SYNC_INTERVAL_MS=300000
